<?php
$filters = $this->filters;
$opts    = $this->options;
$rows    = $this->rows;
?>
<div class="container-fluid">
    <h3>Historia cen</h3>

    <form method="get" class="row g-2 mb-3">
        <div class="col-sm-3">
            <label class="form-label">Numer lokalu</label>
            <input type="text" name="number" value="<?php echo $this->escape($filters['number']); ?>" class="form-control" />
        </div>
        <div class="col-sm-3">
            <label class="form-label">Inwestycja</label>
            <select name="investment_id[]" class="form-select" multiple>
                <?php foreach ($opts['investments'] as $name): ?>
                    <option value="<?php echo $this->escape($name); ?>" <?php echo in_array($name, (array)$filters['investment']) ? 'selected' : ''; ?>>
                        <?php echo $this->escape($name); ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        <div class="col-sm-3">
            <label class="form-label">Status</label>
            <select name="status_id[]" class="form-select" multiple>
                <?php foreach ($opts['statuses'] as $name): ?>
                    <option value="<?php echo $this->escape($name); ?>" <?php echo in_array($name, (array)$filters['status']) ? 'selected' : ''; ?>>
                        <?php echo $this->escape($name); ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        <div class="col-sm-3">
            <label class="form-label">Typ lokalu</label>
            <select name="type_id[]" class="form-select" multiple>
                <?php foreach ($opts['types'] as $name): ?>
                    <option value="<?php echo $this->escape($name); ?>" <?php echo in_array($name, (array)$filters['type']) ? 'selected' : ''; ?>>
                        <?php echo $this->escape($name); ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>

        <div class="col-sm-3">
            <label class="form-label">Data od</label>
            <input type="date" name="date_from" value="<?php echo $this->escape($filters['date_from']); ?>" class="form-control" />
        </div>
        <div class="col-sm-3">
            <label class="form-label">Data do</label>
            <input type="date" name="date_to" value="<?php echo $this->escape($filters['date_to']); ?>" class="form-control" />
        </div>
        <div class="col-sm-3 align-self-end">
            <button type="submit" class="btn btn-primary">Filtruj</button>
            <a href="<?php echo $this->url(['controller' => 'price-history', 'action' => 'index'], null, true); ?>" class="btn btn-secondary">Wyczyść</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm table-striped">
            <thead>
            <tr>
                <th>L.p.</th>
                <th>Status</th>
                <th>Data zmiany</th>
                <th>Inwestycja</th>
                <th>Typ lokalu</th>
                <th>Numer lokalu</th>
                <th>Poprzednia cena</th>
                <th>Nowa cena</th>
                <th>Poprzednia cena/m2</th>
                <th>Nowa cena/m2</th>
            </tr>
            </thead>
            <tbody>
            <?php $lp = 1 + (($filters['page'] - 1) * $filters['limit']); ?>
            <?php foreach ($rows as $r): ?>
                <tr>
                    <td><?php echo (int)$lp++; ?></td>
                    <td><?php echo $this->escape($r->status_name); ?></td>
                    <td><?php echo $this->escape($r->changed_at); ?></td>
                    <td><?php echo $this->escape($r->investment_name); ?></td>
                    <td><?php echo $this->escape($r->type_name); ?></td>
                    <td><?php echo $this->escape($r->realestate_number); ?></td>
                    <td><?php echo number_format((float)$r->old_price, 2, ',', ' '); ?></td>
                    <td><?php echo number_format((float)$r->new_price, 2, ',', ' '); ?></td>
                    <td><?php echo number_format((float)$r->old_mkw_price, 2, ',', ' '); ?></td>
                    <td><?php echo number_format((float)$r->new_mkw_price, 2, ',', ' '); ?></td>
                </tr>
            <?php endforeach; ?>
            <?php if (empty($rows)): ?>
                <tr><td colspan="10" class="text-center">Brak danych</td></tr>
            <?php endif; ?>
            </tbody>
        </table>
    </div>
</div>